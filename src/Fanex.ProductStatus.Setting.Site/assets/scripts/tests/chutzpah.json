{
  "Framework": "jasmine",
  "EnableCodeCoverage": "true",
  "Compile": {
    "Mode": "External",
    "Extensions": [ ".ts" ]
  },
  "CodeCoverageExcludes": [
    "*\\libs\\*"
  ],
  "CodeCoverageIgnores": [
    "*\\tests\\*"
  ],

  "CodeCoverageExecutionMode": "Manual",
  "References": [
    { "Path": "libs/jquery/jquery-1.11.3.js" },
    { "Path": "libs/jasmine.js" },
    { "Path": "libs/jasmine-jquery.js" },
    { "Path": "../../../typings/globals/jasmine-jquery/index.d.ts" },

    { "Path": "libs/jquery/blockUI.js" },

    { "Path": "../product-status-setting/product-status-setting.ts" }
  ],
  "Tests": [
    {
      "Path": "apps/product-status-setting",
      "Excludes": [ "**.js.map", "**.js", "**-template.ts" ]
    },
    {
      "Path": "apps/samples/spec",
      "Excludes": [ "**.js.map", "**-template.ts" ]
    },
    {
      "Path": "apps/samples",
      "Excludes": [ "**.js.map", "**-template.ts" ]
    }
  ]
}