@model QueryViewModel
@{
    Layout = null;
    string assetsVersion = "201810031422";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="stylesheet" href="@Url.Content("~/Areas/ProductStatusSetting/Styles/product-status-setting.min.css?v=")@assetsVersion"/>
</head>
<body>
    <div id="sectionMessage" class="msg-container hide"></div>
    @if (Model.HasData)
    {
        <table class="tbl-product margin-top10" id="tbl-product">
            <thead>
                <tr>
                    <th class="title" colspan="@(Model.CustRole * 2)"> @Model.GetRoleName(Model.CustRole): @Model.CustName</th>
                </tr>
                <tr>
                    <th rowspan="2"></th>
                    <th rowspan="2">
                        @if (Model.IsMultipleBetTypes)
                        {
                            var roleName = Model.GetRoleName(Model.CustRole);
                            <div class="current-role">@roleName</div>
                            <div class="all-status">
                                <span class="enabled gray"
                                      data-roleid="@Model.CustRole"
                                      title="@string.Format(Resources.SearchAccountTHeadTooltip, Resources.Enable.ToLower(), roleName)">
                                    @Resources.Enable
                                </span>
                                <span class="disabled gray"
                                      data-roleid="@Model.CustRole"
                                      title="@string.Format(Resources.SearchAccountTHeadTooltip, Resources.Disable.ToLower(), roleName)">
                                    @Resources.Disable
                                </span>
                            </div>
                        }
                        else
                        {
                            @Model.GetRoleName(Model.CustRole)
                        }
                    </th>
                    @RenderHeaderLevelName(Model.CustRole)
                </tr>
                <tr>
                    @RenderHeaderStatus(Model.CustRole, Model.IsMultipleBetTypes)
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.ProductStatus)
                {
                    int totalDisabledMaster = 0, totalDisabledAgent = 0;
                    <tr>
                        <td class="bettype-name">@item.Name</td>
                        <td>@RenderStatus(item.SportType, item.BetType, item.IsDisabled, item.IsDisabledUpline, Model.CustRole)</td>

                        @if (item.IsShowMaster)
                        {
                            totalDisabledMaster = item.Master.TotalDisabled;

                            @RenderDownlineStatus(
                               item.SportType,
                               item.BetType,
                               RoleIdentity.Master,
                               item.IsDisabledUpline,
                               item.Master)
                        }

                        @if (item.IsShowAgent)
                        {
                            totalDisabledAgent = item.Agent.TotalDisabled;

                            @RenderDownlineStatus(
                               item.SportType,
                               item.BetType,
                               RoleIdentity.Agent,
                               item.IsDisabledUpline,
                               item.Agent,
                               Model.CustRole == RoleIdentity.Master ? 0 : totalDisabledMaster)
                        }

                        @if (item.IsShowMember)
                        {
                            @RenderDownlineStatus(
                                item.SportType,
                                item.BetType,
                                RoleIdentity.Member,
                                item.IsDisabledUpline,
                                item.Member,
                                Model.CustRole == RoleIdentity.Agent ? 0 : totalDisabledMaster + totalDisabledAgent)
                        }
                    </tr>
                }
            </tbody>
        </table>
        <div class="margin-top10 align-right">
            @if (Model.AllowUpdate)
            {
                <button type="button" class="btn btn-reset" id="btnReset">@Resources.Reset</button>
                <button type="button" class="margin-left5 btn" id="btnSubmit">@Resources.Submit</button>
            }
        </div>
    }
    else
    {
        <div id="sectionMessage" class="msg-container">
            <div class="alerterror align-center"> @Resources.ThereIsNoData</div>
        </div>
    }
    @if (Model.AllowUpdate)
    {
        @Html.Hidden("custId", Model.CustId)
        @Html.Hidden("custName", Model.CustName)
        @Html.Hidden("custRole", Model.CustRole)
        @Html.Hidden("productId", Model.ProductId)
        @Html.Hidden("enabled", Resources.Enabled)
        @Html.Hidden("disabled", Resources.Disabled)
        @Html.Hidden("thereIsNoChange", Resources.ThereIsNoChange)
        @Html.Hidden("updateStatusFailed", Resources.UpdateStatusFailed)
        @Html.Hidden("isMultipleBetTypes", Model.IsMultipleBetTypes)
        @Html.AntiForgeryToken()

        var jsUrl = string.Format(
            "~/Areas/ProductStatusSetting/Scripts/product-status-setting{0}.js?v={1}",
            HttpContext.Current.IsDebuggingEnabled ? string.Empty : ".min",
            assetsVersion);
        <script type="text/javascript" src="@Url.Content(jsUrl)"></script>
    }
</body>
</html>

@helper RenderHeaderLevelName(byte roleId)
{
    while (roleId > 0 && --roleId > 0)
    {
        if (Model.ShowColumnByRoles[roleId])
        {
            <th colspan="2">
                @Model.GetRoleName(roleId)
            </th>
        }
    }
}

@helper RenderHeaderStatus(byte roleId, bool isMultipleBetTypes)
{
    while (roleId > 0 && --roleId > 0)
    {
        if (Model.ShowColumnByRoles[roleId])
        {
            @RenderHeader(roleId, isMultipleBetTypes);
        }
    }
}

@helper RenderHeader(byte roleId, bool isMultipleBetTypes)
{
    var roleName = Model.GetRoleName(roleId);
    if (isMultipleBetTypes)
    {
        <th>
            <span class="enabled gray" data-roleid="@roleId"
                  title="@string.Format(Resources.HeaderTooltip, Resources.Enable.ToLower(), roleName)">
                @Resources.Enable
            </span>
        </th>
        <th>
            <span class="disabled gray" data-roleid="@roleId"
                  title="@string.Format(Resources.HeaderTooltip, Resources.Disable.ToLower(), roleName)">
                @Resources.Disable
            </span>
        </th>
    }
    else
    {
        <th>@Resources.Enable</th>
        <th>@Resources.Disable</th>
    }
}

@helper RenderStatus(
    int sportType,
    int betType,
    bool isDisabled,
    bool isDisabledUpline,
    byte roleId)
{
    var labelText = isDisabled ? Resources.Disabled : Resources.Enabled;
    var labelClass = isDisabledUpline ? "gray" : labelText.ToLowerInvariant();
    var id = string.Format("{0}_{1}_{2}", labelClass, roleId, betType);
    var roleName = Model.GetRoleName(roleId);

    var tbodyEnableDownlineTooltip = string.Format(Resources.SearchAccountTBodyTooltip, Resources.Enable.ToLower(), roleName);
    var tbodyDisableDownlineTooltip = string.Format(Resources.SearchAccountTBodyTooltip, Resources.Disable.ToLower(), roleName);

    <input type="checkbox" class="checkbox-hide" id="@id"
           data-roleid="@roleId"
           data-disabledupline="@isDisabledUpline"
           data-sporttype="@sportType"
           data-bettype="@betType"
           data-originstatus="@isDisabled"
           @(isDisabled ? string.Empty : "checked ")
           @(isDisabledUpline ? "disabled " : string.Empty) />

    <label for="@id" class="@labelClass"
           title="@(isDisabled ? tbodyEnableDownlineTooltip : tbodyDisableDownlineTooltip)"
           data-enabletooltip="@tbodyEnableDownlineTooltip"
           data-disabletooltip="@tbodyDisableDownlineTooltip">
        @labelText
    </label>
}

@helper RenderDownlineStatus(
    int sportType,
    int betType,
    byte roleId,
    bool isDisabledUpline,
    DownlineStatusViewModel downlineStatus,
    int totalDisabledUpline = 0)
{
    var enabledSpanClass = "enabled" + (downlineStatus.IsDisabled || isDisabledUpline || totalDisabledUpline > 0 ? " gray" : string.Empty);
    var enabledId = string.Format("enabled_{0}_{1}", roleId, betType);
    var disabledSpanClass = "disabled" + (downlineStatus.IsDisabled || isDisabledUpline ? " gray" : string.Empty);
    var disabledId = string.Format("disabled_{0}_{1}", roleId, betType);
    var roleName = Model.GetRoleName(roleId);

    <td>
        <span id="@enabledId" class="@enabledSpanClass"
              title="@string.Format(Resources.TBodyDownlineTooltip, Resources.Enable.ToLower(), roleName + "s")"
              data-roleid="@roleId"
              data-sporttype="@sportType"
              data-bettype="@betType"
              data-total="@downlineStatus.Total"
              data-totalenabled="@downlineStatus.TotalEnabled">@downlineStatus.TotalEnabled.ToString("N0")</span>
    </td>
    <td>
        <span id="@disabledId" class="@disabledSpanClass"
              title="@string.Format(Resources.TBodyDownlineTooltip, Resources.Disable.ToLower(), roleName + "s")"
              data-roleid="@roleId"
              data-sporttype="@sportType"
              data-total="@downlineStatus.Total"
              data-totaldisabled="@downlineStatus.TotalDisabled"
              data-bettype="@betType">@downlineStatus.TotalDisabled.ToString("N0")</span>
    </td>
}
