@using Newtonsoft.Json
@model MultipleQueryViewModel

@{
    Layout = null;
    string assetsVersion = "201810031426";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="stylesheet" href="@Url.Content("~/Areas/ProductStatusSetting/Styles/product-status-setting-multiple.min.css?v=")@assetsVersion">
</head>
<body>
    <div id="sectionMessage" class="msg-container hide"></div>

    <div class="filter">
        @using (Html.BeginForm("MultipleView", "ProductStatusSetting", FormMethod.Post, new { id = "product-form", method = "Post" }))
        {

            @Html.DropDownListFor(model => model.Products,
             new List<SelectListItem>(
                 Model.Products.Select(product => new SelectListItem { Value = product.Id.ToString(), Text = product.Name })),
                     "Select Product",
                     new { @class = "form-control", id = "productIds" })

            if (!Model.ProductStatus.Any() && !Model.ProductId.Equals(0))
            {
                <span class="alerterror align-center"> @Resources.UnauthorizeProductMessage</span>
            }

            @Html.Hidden("productId", Model.ProductId)
            @Html.Hidden("custIds", Model.CustIds)
            @Html.Hidden("custNames", Model.CustNames)
            @Html.Hidden("productIds", Model.ProductIds)
            @Html.Hidden("custRole", Model.CustRole)
            @Html.Hidden("custId", Model.CustIds.Split(',')[0])
            @Html.Hidden("groupId", Context.Request.Query["groupid"].ToString())
            @Html.Hidden("isGroup", Model.IsGroup)
            @Html.Hidden("recommend", Model.Recommend)
        }
    </div>

    @Html.Hidden("productsList", JsonConvert.SerializeObject(Model.Products))
    @Html.Hidden("isMultipleBetTypes", Model.ProductStatus.Count() > 1)
    @Html.Hidden("enableAll", Resources.EnableAll)
    @Html.Hidden("disableAll", Resources.DisableAll)
    @Html.Hidden("thereIsNoChange", Resources.ThereIsNoChange)
    @Html.Hidden("updateStatusFailed", Resources.UpdateStatusFailed)

    <div id="dialog-confirm" title="@Resources.Warning!!!" style="display:none">
        <p>@Resources.ConfirmBeforeMultipleUpdate</p>
    </div>

    @if (Model.ProductStatus.Any())
    {
        @Html.Partial("~/Areas/ProductStatusSetting/Views/Multiple/MultiplePartialView.cshtml", Model)
    }

    @{
        var jsUrl = string.Format(
            "~/Areas/ProductStatusSetting/Scripts/product-status-setting-multiple{0}.js?v={1}",
            ".min", @* TODO: Add environment-based debug check *@
            assetsVersion);
    }
    <script type="text/javascript" src="@Url.Content(jsUrl)"></script>
</body>
</html>