@using Fanex.ProductStatus.Setting.Site
@{
    Layout = null;
    var productIdsForMultiple = string.Join(",", ProductListConsts.Products.Select(p => p.Id));
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
</head>
