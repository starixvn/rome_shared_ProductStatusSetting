    <div>
        <h1>Single Update</h1>
        <div style="width:20%;display:inline-block">
            <h3>Edit Super: supertest1</h3>
            <ol>
                @foreach (var item in ProductListConsts.Products)
                {
                    <li>
                        <a href="@Url.Content("~/ProductStatusSetting/Index?productId=" + item.Id + "&custId=1176070&custRole=4&custName=supertest1")"
                           target="_blank">@item.Name</a>
                    </li>
                }
